<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Application de Chat</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
        <style>
            #chat-container {
                display: none;
            }

            #message {
                height: 300px;
                overflow-y: auto;
                list-style-type: none;
                padding: 0;
            }
        </style>
    </head>

    <body>
        <div class="container mt-5">
            <!-- Modal pour le pseudo -->
            <div class="card">
                <div class="card-body">
                    <h5 id="pseudoTitleContainer" class="card-title">Bienvenue au Chat </h5>
                    <form id="pseudoForm">
                        <div class="mb-3">
                            <label for="pseudo" class="form-label">Entrez votre pseudo</label>
                            <input type="text" class="form-control" id="pseudo" placeholder="Votre pseudo" required />
                        </div>
                        <button type="submit" class="btn btn-primary">Rejoindre le chat</button>
                    </form>
                </div>
            </div>

            <!-- Container du chat -->
            <div id="chat-container" class="card mt-4">
                <div class="card-body">
                    <h5 class="card-title">Chat en direct</h5>
                    <ul id="message" class="border rounded p-3 mb-3"></ul>
                    <form id="messageForm" class="d-flex">
                        <input type="text" class="form-control me-2" id="m" autocomplete="off" placeholder="Votre message" />
                        <button type="submit" class="btn btn-primary">Envoyer</button>
                    </form>
                </div>
            </div>
        </div>

        <script src="/socket.io/socket.io.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
        <script src="js/app.js"></script>
    </body>
</html>
