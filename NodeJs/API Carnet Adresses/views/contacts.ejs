<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Gestion des contacts</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    </head>
    <body>
        <div class="container mt-5">
            <!-- Liste des contacts -->
            <h2 class="mb-3">Liste des contacts</h2>
            <a class="btn btn-primary btn-sm" href="/api/contacts/add" role="button">Ajouter</a>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Prénom</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="contactsList">
                    <% if (contacts) { %>
                        <% contacts.map((contact, key) => { %>
                            <tr>
                                <td><%= contact.firstname %></td>
                                <td><%= contact.lastname %></td>
                                <td><%= contact.email %></td>
                                <td><%= contact.phone %></td>
                                <td class="d-flex gap-2">
                                    <a class="btn btn-warning btn-sm" href="/api/contacts/mod/<%= contact.id %>" role="button">Modifier</a>
                                    <form method="POST" action="/api/contacts/delete/<%= contact.id %>?_method=DELETE">
                                        <button class="btn btn-danger btn-sm" type="submit" role="button">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
