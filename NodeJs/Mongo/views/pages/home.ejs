<%- include('../templates/header') %>

<h1>Todo List</h1>
<h3>Ajouter une Tâche</h3>
<form action="/addTaskController" method="post" style="display: flex;flex-direction: column;align-items: center;gap: 0.5rem; padding: 0.5rem;">
    <input type="text" name="description" id="">
    <button type="submit" style="background-color: blue;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Ajouter</button>
</form>
<section style="display: flex;flex-direction: column;width: 33.33%;align-items: center;border: solid 1px gray; border-radius: 15px;padding: 0.5rem;">
    <h3>Tâches</h3>
    <ul style="display: flex;flex-direction: column;gap: 0.5rem;list-style: none;">
        <% if (tasks.length > 0) {
            tasks.map((task, key) => { 
                switch (task.status) {
                    case "Non démarrée": %>
                        <div style="display: flex;gap: 0.5rem;align-items: center;">
                            <form action="/runTask" method="post" style="display: flex; gap:0.5rem;align-items: center;">
                                <li><%= task.description %> - <%= task.status %></li>
                                <input type="hidden" name="id" value="<%= key %>">
                                <button type="submit" style="background-color: green;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Démarrer</button>
                            </form>
                            <form action="/delTask" method="post" style="display: flex;gap: 0.5rem;align-items: center;">
                                <input type="hidden" name="id" value="<%= key %>">
                                <button type="submit" style="background-color: red;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Supprimer</button>
                            </form>
                        </div>
                        <% break;
                    case "En cours": %>
                        <div style="display: flex;gap: 0.5rem;align-items: center;">
                            <form action="/stopTask" method="post" style="display: flex; gap:0.5rem;align-items: center;">
                                <li><%= task.description %> - <%= task.status %></li>
                                <input type="hidden" name="id" value="<%= key %>">
                                <button type="submit" style="background-color: orange;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Suspendre</button>
                            </form>
                            <form action="/outTask" method="post" style="display: flex;gap: 0.5rem;align-items: center;">
                                <input type="hidden" name="id" value="<%= key %>">
                                <button type="submit" style="background-color: black;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Terminer</button>
                            </form>
                            <form action="/delTask" method="post" style="display: flex;gap: 0.5rem;align-items: center;">
                                <input type="hidden" name="id" value="<%= key %>">
                                <button type="submit" style="background-color: red;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Supprimer</button>
                            </form>
                        </div>
                        <% break;
                    case "Suspendu": %>
                        <div style="display: flex;gap: 0.5rem;align-items: center;">
                            <form action="/runTask" method="post" style="display: flex; gap:0.5rem;align-items: center;">
                                <li><%= task.description %> - <%= task.status %></li>
                                <input type="hidden" name="id" value="<%= key %>">
                                <button type="submit" style="background-color: green;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Démarrer</button>
                            </form>
                            <form action="/outTask" method="post" style="display: flex;gap: 0.5rem;align-items: center;">
                                <input type="hidden" name="id" value="<%= key %>">
                                <button type="submit" style="background-color: black;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Terminer</button>
                            </form>
                            <form action="/delTask" method="post" style="display: flex;gap: 0.5rem;align-items: center;">
                                <input type="hidden" name="id" value="<%= key %>">
                                <button type="submit" style="background-color: red;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Supprimer</button>
                            </form>
                        </div>
                        <% break;
                    case "Terminée": %>
                        <div style="display: flex;gap: 0.5rem;align-items: center;">
                            <form action="/delTask" method="post" style="display: flex;gap: 0.5rem;align-items: center;">
                                <li style="text-decoration: line-through;"><%= task.description %> - <%= task.status %></li>
                                <input type="hidden" name="id" value="<%= key %>">
                                <button type="submit" style="background-color: red;color: white;border-radius: 5px;padding: 0.5rem;border-color: gray;">Supprimer</button>
                            </form>
                        </div>
                        <% break;
                    default:
                        break;
                }
            })
        } %>
    </ul>
</section>

<%- include('../templates/footer') %>
